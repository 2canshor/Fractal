    "core_identity": "Use Perspective while a Project is active, then let System Review follow the eight Flows after primary-user Project Completion.",
    "original_system_review_backbone": [
      {
        "implemented_by": [
          "project-assessment",
          "positive-delta",
          "negative-delta",
          "issue-scan",
          "quantity-over-quality"
        ],
        "name": "find-problems",
        "original_question": "Collect the broad Project evidence before narrowing or explaining it.",
        "flow": 1
      },
      {
        "implemented_by": [
          "project-patterns",
          "causal-interpretation",
          "observation-cause-separation"
        ],
        "name": "find-local-patterns",
        "original_question": "Identify meaningful local recurrence without confusing surface similarity with cause.",
        "flow": 2
      },
      {
        "implemented_by": [
          "cross-project-patterns",
          "reversal-check",
          "history-comparison"
        ],
        "name": "find-global-patterns",
        "original_question": "Compare patterns across the relevant Project and improvement history before treating them as isolated.",
        "flow": 3
      },
      {
        "implemented_by": [
          "cause-research",
          "reconciliation",
          "causal-uncertainty"
        ],
        "name": "find-global-pattern-reasons",
        "original_question": "Make the causal reasoning for every Global Pattern explicit, including uncertainty and counterevidence.",
        "flow": 4
      },
      {
        "implemented_by": [
          "curiosity",
          "improvement-options",
          "subtraction-first"
        ],
        "name": "find-global-pattern-solutions",
        "original_question": "Search for possible responses to every Global Pattern without allowing one preferred implementation to end the search.",
        "flow": 5
      },
      {
        "implemented_by": [
          "blueprint-mapping",
          "addition-priority",
          "donor-authority-removal"
        ],
        "name": "map-implementations-to-blueprint",
        "original_question": "Classify every Candidate implementation by its true Blueprint role and apply the rules of its Genre before debate.",
        "flow": 6
      },
      {
        "implemented_by": [
          "two-sided-review",
          "case-for",
          "case-against",
          "final-synthesis"
        ],
        "name": "debate-global-pattern-solutions",
        "original_question": "Challenge the mapped solutions for every Global Pattern before Carson is asked to decide.",
        "flow": 7
      },
      {
        "implemented_by": [
          "human-control",
          "plain-handoff",
          "biggest-remaining-concern",
          "your-decision"
        ],
        "name": "present-decisions-one-by-one",
        "original_question": "Present one fully prepared human-scale decision at a time without hiding the remaining decision set.",
        "flow": 8
      }
    ],
