    "original_system_review_backbone": [
      {
        "step": 1,
        "name": "find-problems",
        "original_question": "What can we learn from the whole Project before filtering or explaining it?",
        "principle": "Quantity over Quality",
        "implemented_by": ["project-assessment", "positive-delta", "negative-delta", "issue-scan"]
      },
      {
        "step": 2,
        "name": "find-local-patterns",
        "original_question": "Why may these observations have happened, and which ones express the same system behaviour?",
        "implemented_by": ["project-patterns", "causal-interpretation"]
      },
      {
        "step": 3,
        "name": "compare-history",
        "original_question": "What did Fractal previously believe, change, and observe afterward?",
        "implemented_by": ["cross-project-patterns", "reversal-check", "cause-research", "external-research", "internal-review", "reconciliation"]
      },
      {
        "step": 4,
        "name": "choose-system-response",
        "original_question": "Can the current system solve this through deletion, simplification, reconfiguration, or modification?",
        "implemented_by": ["improvement-options", "subtraction-first", "three-value-evidence", "experiments", "capability-evidence"]
      },
      {
        "step": 5,
        "name": "reality-check",
        "original_question": "Did Fractal actually improve, or did it merely change?",
        "implemented_by": ["expected-effect", "local-effect", "global-effect", "two-sided-review", "final-assessment", "biggest-remaining-concern", "result", "your-decision", "later-outcome-evaluation"]
      }
    ]
  },
