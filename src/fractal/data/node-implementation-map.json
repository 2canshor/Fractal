        "positive": ["valid-human-confirmation"],
        "negative": ["agent-self-confirmation"],
        "boundary": ["same-summary-idempotence", "material-reconfirmation"],
        "false_positive": ["wording-change-treated-as-material"],
        "missed_trigger": ["material-outcome-change-without-reconfirmation"]
