{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fractal.local/schemas/capability-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "record_version", "capabilities"],
  "properties": {
    "record_type": {"const": "capability-registry"},
    "record_version": {"type": "integer", "const": 1},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "evidenced_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence_ids"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "evidence_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "human_name",
        "owner",
        "source",
        "version",
        "classification",
        "supported_platforms",
        "permissions",
        "secret_requirements",
        "overlap",
        "status"
      ],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "human_name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "classification": {
          "enum": ["canonical", "third-party", "adapter-only", "retired"]
        },
        "supported_platforms": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "secret_requirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "overlap": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "activation_authority", "execution"],
          "properties": {
            "availability": {"$ref": "#/$defs/evidenced_state"},
            "activation_authority": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "authority", "evidence_ids"],
              "properties": {
                "state": {"type": "string", "minLength": 1},
                "authority": {"type": "string", "minLength": 1},
                "evidence_ids": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true
                }
              }
            },
            "execution": {"$ref": "#/$defs/evidenced_state"}
          }
        }
      }
    }
  }
}
