{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fractal.local/schemas/capability-source.schema.json",
  "title": "Fractal Capability Source",
  "description": "Portable metadata for raw external knowledge. A Source is never callable or authoritative.",
  "$ref": "#/$defs/source",
  "$defs": {
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{40}$"
    },
    "portable_text": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/portable_text"},
        "kind": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "target": {"type": ["string", "null"]},
        "effect": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "optional": {"type": "boolean"},
        "confidence": {"type": ["string", "null"]},
        "command": {"type": ["string", "null"]},
        "arguments": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "operations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "provider": {"type": ["string", "null"]},
        "purpose": {"type": ["string", "null"]},
        "requires": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "entrypoint": {"type": ["string", "null"]},
        "package": {"type": ["string", "null"]},
        "range": {"type": ["string", "null"]}
      }
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "scripts",
        "network_effects",
        "write_effects",
        "dependencies",
        "provider_hints",
        "compatibility"
      ],
      "properties": {
        "tools": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "scripts": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "network_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "write_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "provider_hints": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "compatibility": {"type": "object", "additionalProperties": true}
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "spdx",
        "evidence",
        "constraints",
        "candidate_content_allowed"
      ],
      "properties": {
        "status": {
          "enum": ["verified", "unclear", "missing", "incompatible"]
        },
        "spdx": {"type": ["string", "null"], "minLength": 1},
        "evidence": {"type": ["string", "null"], "minLength": 1},
        "constraints": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "candidate_content_allowed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {
            "required": ["spdx"],
            "properties": {"candidate_content_allowed": {"type": "boolean"}}
          },
          "else": {
            "properties": {"candidate_content_allowed": {"const": false}}
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_reuse",
        "runtime_dependency",
        "execution_authority",
        "persistence_authority",
        "notes"
      ],
      "properties": {
        "content_reuse": {"enum": ["candidate-copy", "metadata-only"]},
        "runtime_dependency": {"const": "forbidden"},
        "execution_authority": {"const": false},
        "persistence_authority": {"const": false},
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "source_only": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callable",
        "resolvable",
        "active",
        "execution_authority",
        "persistence_authority"
      ],
      "properties": {
        "callable": {"const": false},
        "resolvable": {"const": false},
        "active": {"const": false},
        "execution_authority": {"const": false},
        "persistence_authority": {"const": false}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_id",
        "observed_at",
        "locator",
        "commit",
        "tag",
        "version",
        "path",
        "content_sha256",
        "tree_sha256",
        "file_sha256",
        "evidence",
        "notes"
      ],
      "properties": {
        "provenance_id": {"type": "string", "pattern": "^provenance-[a-f0-9]{32}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "locator": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/commit"},
        "tag": {"type": ["string", "null"], "minLength": 1},
        "version": {"type": ["string", "null"], "minLength": 1},
        "path": {"type": ["string", "null"], "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_version",
        "source_id",
        "name",
        "source_type",
        "donor",
        "upstream",
        "licence",
        "constraints",
        "retrieved_at",
        "claimed_capabilities",
        "declarations",
        "status",
        "source_only",
        "provenance"
      ],
      "properties": {
        "$schema": {"const": "https://fractal.local/schemas/capability-source.schema.json"},
        "record_type": {"const": "capability-source"},
        "record_version": {"const": 1},
        "source_id": {"type": "string", "pattern": "^source-[a-f0-9]{32}$"},
        "name": {"type": "string", "minLength": 1},
        "source_type": {"enum": ["library", "skill", "spec"]},
        "donor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["donor_id", "name"],
          "properties": {
            "donor_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
            "name": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locator",
            "commit",
            "tag",
            "version",
            "path",
            "content_sha256",
            "tree_sha256",
            "file_sha256"
          ],
          "properties": {
            "locator": {"type": "string", "minLength": 1},
            "commit": {"$ref": "#/$defs/commit"},
            "tag": {"type": ["string", "null"], "minLength": 1},
            "version": {"type": ["string", "null"], "minLength": 1},
            "path": {"type": ["string", "null"], "minLength": 1},
            "content_sha256": {"$ref": "#/$defs/sha256"},
            "tree_sha256": {"$ref": "#/$defs/sha256"},
            "file_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "licence": {"$ref": "#/$defs/licence"},
        "constraints": {"$ref": "#/$defs/constraints"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "claimed_capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "declarations": {"$ref": "#/$defs/declarations"},
        "status": {"const": "source-only"},
        "source_only": {"$ref": "#/$defs/source_only"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/provenance"}
        }
      }
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "record_version", "sources"],
      "properties": {
        "$schema": {"const": "https://fractal.local/schemas/capability-source.schema.json"},
        "record_type": {"const": "capability-source-catalogue"},
        "record_version": {"const": 1},
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/source"}
        }
      }
    }
  }
}
