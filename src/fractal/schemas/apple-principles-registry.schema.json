{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fractal.local/schemas/apple-principles-registry.schema.json",
  "title": "Fractal Apple Principles Registry",
  "description": "Portable, source-bound HIG acceptance registry. It is a System Review acceptance layer; Continuous Improvement remains the Fractal core.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "record_type",
    "record_version",
    "continuous_improvement_is_core",
    "acceptance_layer_only",
    "library",
    "principles",
    "cross_cutting_requirements",
    "sources"
  ],
  "properties": {
    "$schema": {"const": "https://fractal.local/schemas/apple-principles-registry.schema.json"},
    "record_type": {"const": "apple-principles-registry"},
    "record_version": {"const": 1},
    "continuous_improvement_is_core": {"const": true},
    "acceptance_layer_only": {"const": true},
    "library": {"$ref": "#/$defs/library"},
    "principles": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/principle"}
    },
    "cross_cutting_requirements": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "sources": {
      "type": "array",
      "minItems": 171,
      "maxItems": 171,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1},
    "source_id": {
      "type": "string",
      "pattern": "^hig:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source_id"}
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue_title",
        "index_version",
        "index_updated",
        "index_label",
        "index_sha256",
        "hig_source_count",
        "source_manifest_sha256",
        "applicability_counts",
        "source_variant_counts"
      ],
      "properties": {
        "catalogue_title": {"$ref": "#/$defs/nonblank"},
        "index_version": {"const": 2},
        "index_updated": {"type": "string", "format": "date"},
        "index_label": {"const": "Apple/INDEX.json"},
        "index_sha256": {"const": "94b10ebc13cbb5dd7542487e8a232b315c191b6fc2e801f15cec5081c502d1d1"},
        "hig_source_count": {"const": 171},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "applicability_counts": {
          "const": {"universal": 12, "conditional": 109, "not-current": 50}
        },
        "source_variant_counts": {
          "const": {"current-(2)": 143, "indexed-only": 28}
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principle_id",
        "title",
        "source_refs",
        "acceptance",
        "continuous_improvement_reinforcement"
      ],
      "properties": {
        "principle_id": {
          "enum": [
            "purpose",
            "agency",
            "responsibility",
            "familiarity",
            "flexibility",
            "simplicity",
            "craft",
            "delight"
          ]
        },
        "title": {"$ref": "#/$defs/nonblank"},
        "source_refs": {"$ref": "#/$defs/source_refs"},
        "acceptance": {"$ref": "#/$defs/nonblank"},
        "continuous_improvement_reinforcement": {"$ref": "#/$defs/nonblank"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "title",
        "source_refs",
        "acceptance",
        "continuous_improvement_reinforcement"
      ],
      "properties": {
        "requirement_id": {
          "enum": [
            "generative-ai",
            "accessibility",
            "inclusion",
            "privacy",
            "writing",
            "feedback",
            "undo-and-recovery",
            "loading-and-progress",
            "offering-help",
            "continuous-improvement-core"
          ]
        },
        "title": {"$ref": "#/$defs/nonblank"},
        "source_refs": {"$ref": "#/$defs/source_refs"},
        "acceptance": {"$ref": "#/$defs/nonblank"},
        "continuous_improvement_reinforcement": {"$ref": "#/$defs/nonblank"},
        "must_reinforce_continuous_improvement": {"const": true}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "category",
        "indexed_label",
        "source_label",
        "source_variant",
        "official_url",
        "sha256",
        "applicability",
        "applicability_rule"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "title": {"$ref": "#/$defs/nonblank"},
        "category": {"enum": ["Build", "Design", "Render", "Secure"]},
        "indexed_label": {
          "type": "string",
          "pattern": "^Apple/(?:Build|Design|Render|Secure)/HIG - .+\\.txt$"
        },
        "source_label": {
          "type": "string",
          "pattern": "^Apple/(?:Build|Design|Render|Secure)/HIG - .+\\.txt$"
        },
        "source_variant": {"enum": ["current-(2)", "indexed-only"]},
        "official_url": {
          "type": "string",
          "pattern": "^https://developer\\.apple\\.com/design/human-interface-guidelines/[a-z0-9-]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "applicability": {"enum": ["universal", "conditional", "not-current"]},
        "applicability_rule": {"$ref": "#/$defs/nonblank"}
      }
    }
  }
}
